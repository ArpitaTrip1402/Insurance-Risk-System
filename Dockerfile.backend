
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY docker/backend-requirements.txt ./requirements.txt

RUN python -m pip install --no-cache-dir --default-timeout=600 --retries=15 -r requirements.txt

COPY src/ ./src/
COPY models/ ./models/

EXPOSE 10000

CMD ["sh", "-c", "uvicorn src.api:app --host 0.0.0.0 --port ${PORT:-10000}"]
