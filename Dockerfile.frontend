FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY docker/frontend-requirements.txt ./requirements.txt

RUN python -m pip install --no-cache-dir --default-timeout=600 --retries=15 -r requirements.txt

COPY frontend/ ./frontend/

EXPOSE 10000

CMD ["sh", "-c", "streamlit run frontend/app.py --server.address=0.0.0.0 --server.port=${PORT:-10000}"]
